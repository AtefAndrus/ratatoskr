{
  "name": "ratatoskr",
  "version": "0.8.9",
  "private": true,
  "description": "Relays posts from watched X accounts to Discord channels via Web Push and X internal GraphQL",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "cli": "bun run src/cli.ts",
    "test": "bun typecheck && bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "lint:md": "markdownlint-cli2 \"docs/**/*.md\" \"*.md\"",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "format:md": "markdownlint-cli2 --fix \"docs/**/*.md\" \"*.md\"",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun test && bun run lint:md",
    "changelog": "mise exec -- git-cliff --output CHANGELOG.md",
    "release:prepare": "bash scripts/release-prepare.sh",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "bun-types": "1.4.4",
    "lefthook": "2.2.2",
    "markdownlint-cli2": "0.24.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2"
  }
}
