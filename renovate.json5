{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:best-practices",
    "group:allNonMajor",
    "group:allDigest",
    ":semanticCommitTypeAll(build)",
  ],
  timezone: "Asia/Tokyo",
  // .npmrc で取得元を Takumi Guard に固定しているため、Mend hosted の sidecar にも認証を渡す
  hostRules: [
    {
      matchHost: "https://npm.flatt.tech/",
      hostType: "npm",
      token: "{{ secrets.TAKUMI_GUARD_TOKEN }}",
    },
  ],
  schedule: ["* 0-8 * * 1"],
  lockFileMaintenance: { enabled: false },
  vulnerabilityAlerts: { minimumGroupSize: 1 },
  semanticCommits: "enabled",
  labels: ["dependencies"],
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/.+\\.ya?ml$/"],
      matchStrings: [
        "docker\\.io/rhysd/actionlint:(?<currentValue>\\d+\\.\\d+\\.\\d+)@(?<currentDigest>sha256:[a-f0-9]{64})",
      ],
      depNameTemplate: "rhysd/actionlint",
      datasourceTemplate: "docker",
    },
  ],
  packageRules: [
    // 供給網対策のクールダウン
    {
      matchUpdateTypes: ["major", "minor", "patch", "digest", "pinDigest"],
      minimumReleaseAge: "3 days",
    },
    // major は CI で捕まえにくい挙動の変化を含みうるので自動マージせず、人が読んでマージする
    {
      matchUpdateTypes: ["minor", "patch", "digest", "pinDigest"],
      automerge: true,
      automergeStrategy: "squash",
    },
    // separateMajorMinor: false の 3 グループは、自動マージを待つ PR に後から major が加わりうる。
    // GitHub の auto-merge は一度付くと Renovate が外さないので使わず (platformAutomerge: false)、
    // Renovate が実行ごとに今の中身で automerge を判定し直して自分でマージする
    // bun は mise / Dockerfile / bun-types の 3 経路を 1 本の PR に載せ、CI の drift-check を通す
    {
      groupName: "bun toolchain",
      groupSlug: "bun-toolchain",
      matchDepNames: ["bun", "oven/bun", "bun-types"],
      separateMajorMinor: false,
      platformAutomerge: false,
    },
    // oxlint / oxfmt / oxlint-tsgolint は同じ oxc リリース列で動くので揃えて上げる
    {
      groupName: "oxc toolchain",
      groupSlug: "oxc-toolchain",
      matchDepNames: ["oxlint", "oxfmt", "oxlint-tsgolint"],
      separateMajorMinor: false,
      platformAutomerge: false,
    },
    {
      groupName: "zizmor",
      groupSlug: "zizmor",
      matchPackageNames: ["ghcr.io/zizmorcore/zizmor", "zizmorcore/zizmor-action"],
      minimumGroupSize: 2,
      separateMajorMinor: false,
      platformAutomerge: false,
    },
    {
      matchPackageNames: ["ghcr.io/zizmorcore/zizmor"],
      minimumReleaseAge: null,
      pinDigests: false,
    },
  ],
}
